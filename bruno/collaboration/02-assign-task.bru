meta {
  name: 02 Assign Task
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/tasks/{{taskId}}/assign
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  "assigneeEmail": "{{demoUserEmail}}"
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
