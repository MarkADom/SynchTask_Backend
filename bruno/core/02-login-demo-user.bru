meta {
  name: 02 Login Demo User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  "email": "{{demoUserEmail}}",
  "password": "{{demoUserPassword}}"
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("store user token", function () {
    const json = res.getBody({ parse: true });
    bru.setVar("userAccessToken", json.accessToken);
    bru.setVar("userRefreshToken", json.refreshToken);
  });
}
