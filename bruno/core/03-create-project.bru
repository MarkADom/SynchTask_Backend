meta {
  name: 03 Create Project
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/projects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  "name": "Portfolio Project {{runId}}",
  "description": "Lifecycle demo"
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("store projectId", function () {
    const json = res.getBody({ parse: true });
    bru.setVar("projectId", String(json.id));
  });
}
