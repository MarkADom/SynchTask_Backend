put {
  url: {{baseUrl}}/tasks/{{taskId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  "title": "Updated Task {{runId}}"
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
