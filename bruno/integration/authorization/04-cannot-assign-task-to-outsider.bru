meta {
  name: 04 Cannot assign task to outsider
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/tasks/{{authorizationTaskId}}/assign?email={{authorizationOutsiderEmail}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authorizationOwnerToken}}
}

script:pre-request {
  const baseUrl = bru.getVar("baseUrl") || "http://localhost:8081";
  const ownerToken = bru.getVar("authorizationOwnerToken");
  const runId = String(Date.now());
  const ownerPassword = bru.getVar("ownerPassword") || "StrongPass123!";

  if (!ownerToken) throw new Error("Missing required variable: authorizationOwnerToken");

  const outsiderEmail = `authorization.outsider.${runId}@example.com`;

  const registerOutsiderRes = await bru.sendRequest({
    method: 'POST',
    url: `${baseUrl}/auth/register`,
    headers: { 'Content-Type': 'application/json' },
    data: {
      name: 'Authorization Outsider',
      email: outsiderEmail,
      password: ownerPassword
    }
  });

  if (registerOutsiderRes.status !== 201) throw new Error(`Outsider register failed: ${registerOutsiderRes.status}`);

  const createBoardRes = await bru.sendRequest({
    method: 'POST',
    url: `${baseUrl}/boards`,
    headers: {
      'Content-Type': 'application/json',
      Authorization: `Bearer ${ownerToken}`
    },
    data: {
      name: `Authorization Assignment Board ${runId}`,
      color: '#A78BFA',
      description: 'Authorization outsider assignment check'
    }
  });

  if (createBoardRes.status !== 200) throw new Error(`Board creation failed: ${createBoardRes.status}`);

  const createTaskRes = await bru.sendRequest({
    method: 'POST',
    url: `${baseUrl}/tasks`,
    headers: {
      'Content-Type': 'application/json',
      Authorization: `Bearer ${ownerToken}`
    },
    data: {
      title: `Authorization Task ${runId}`,
      description: 'Task used for outsider assignment denial',
      assignees: [],
      labels: ['authorization'],
      boardId: createBoardRes.data.id,
      status: 'TODO',
      priority: 'MID'
    }
  });

  if (createTaskRes.status !== 200) throw new Error(`Task creation failed: ${createTaskRes.status}`);

  bru.setVar("authorizationTaskId", String(createTaskRes.data.id));
  bru.setVar("authorizationOutsiderEmail", outsiderEmail);
}

tests {
  test("status 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}