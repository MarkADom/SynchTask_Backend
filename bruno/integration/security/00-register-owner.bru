meta {
  name: 00 Register security owner
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Security Owner",
    "email": "{{securityOwnerEmail}}",
    "password": "{{ownerPassword}}"
  }
}

script:pre-request {
  const securityRunId = String(Date.now());
  bru.setVar("securityRunId", securityRunId);
  bru.setVar("securityOwnerEmail", `security.owner.${securityRunId}@example.com`);
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("capture owner id", function () {
    const body = res.getBody({ parse: true });
    expect(body.id).to.be.a('number');
    bru.setVar("securityOwnerId", String(body.id));
  });
}
