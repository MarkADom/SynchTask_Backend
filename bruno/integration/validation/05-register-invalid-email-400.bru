}

body:json {
  {
    "name": "Validation Invalid Email",
    "email": "not-an-email",
    "password": "{{ownerPassword}}"
  }
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
