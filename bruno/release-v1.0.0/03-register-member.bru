meta {
  name: 03 Register member
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

script:pre-request {
  const runId = bru.getVar("runId");
  if (!runId) throw new Error("Missing required variable: runId");
  bru.setVar("memberEmail", `member.${runId}@example.com`);
}

body:json {
  "name": "Member User",
  "email": "{{memberEmail}}",
  "password": "{{memberPassword}}"
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("capture member id", function () {
    const body = res.getBody();
    expect(body.id).to.be.a('number');
    bru.setVar("memberId", String(body.id));
  });
}
