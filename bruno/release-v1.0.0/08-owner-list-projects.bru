meta {
  name: 08 Owner lists projects
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/projects
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

script:pre-request {
  const token = bru.getVar("ownerToken");
  const projectId = bru.getVar("projectId");
  if (!token) throw new Error("Missing required variable: ownerToken");
  if (!projectId) throw new Error("Missing required variable: projectId");
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("project appears in owner listing", function () {
    const body = res.getBody();
    const projectId = Number(bru.getVar("projectId"));
    expect(Array.isArray(body)).to.equal(true);
    expect(body.some(p => p.id === projectId)).to.equal(true);
  });
}
