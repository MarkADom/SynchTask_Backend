meta {
  name: 09 Owner creates board
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/boards
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

headers {
  Content-Type: application/json
}

script:pre-request {
  const token = bru.getVar("ownerToken");
  const runId = bru.getVar("runId");
  if (!token) throw new Error("Missing required variable: ownerToken");
  if (!runId) throw new Error("Missing required variable: runId");
}

body:json {
  "name": "Board {{runId}}",
  "color": "#60A5FA",
  "description": "Release board"
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("capture board id", function () {
    const body = res.getBody();
    expect(body.id).to.be.a('number');
    bru.setVar("boardId", String(body.id));
  });
}
