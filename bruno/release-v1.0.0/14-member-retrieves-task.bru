meta {
  name: 14 Member retrieves task
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/tasks/{{taskId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{memberToken}}
}

script:pre-request {
  const memberToken = bru.getVar("memberToken");
  const taskId = bru.getVar("taskId");
  if (!memberToken) throw new Error("Missing required variable: memberToken");
  if (!taskId) throw new Error("Missing required variable: taskId");
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("member sees expected task", function () {
    const body = res.getBody();
    expect(body.id).to.equal(Number(bru.getVar("taskId")));
  });
}
