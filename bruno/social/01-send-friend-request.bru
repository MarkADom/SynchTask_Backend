meta {
  name: 01 Send Friend Request
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/friends/request
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  "email": "{{demoUserEmail}}"
}

tests {
  test("status 200 or 201", function () {
    expect([200,201]).to.include(res.getStatus());
  });
}
