meta {
  name: 02 Accept Friend Request
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/friends/accept
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  "email": "{{demoUserEmail}}"
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
