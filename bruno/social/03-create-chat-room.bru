meta {
  name: 03 Create Chat Room
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/chat/rooms
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  "participantEmail": "{{demoUserEmail}}"
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("store chatRoomId", function () {
    const json = res.getBody({ parse: true });
    bru.setVar("chatRoomId", String(json.id));
  });
}
