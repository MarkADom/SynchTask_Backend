meta {
  name: Auth - POST /auth/register
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "QA Automation",
    "email": "{{testEmail}}",
    "password": "{{testPassword}}"
  }
}

script:pre-request {
  const random = Date.now();
  bru.setVar("testEmail", `qa.user.${random}@example.com`);
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns created id and email", function () {
    const json = res.getBody({ parse: true });
    expect(json.id).to.exist;
    expect(json.email).to.equal(bru.getVar("testEmail"));
  });
}
