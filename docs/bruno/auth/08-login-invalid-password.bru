meta {
  name: Auth - POST /auth/login with invalid password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{testEmail}}",
    "password": "invalid-password"
  }
}

tests {
  test("status is 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
