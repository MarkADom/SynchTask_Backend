meta {
  name: Public - GET /auth/.well-known/openid-configuration
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/auth/.well-known/openid-configuration
  body: none
  auth: none
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("response contains OIDC fields", function () {
    const json = res.getBody({ parse: true });
    expect(json.issuer).to.exist;
    expect(json.jwks_uri).to.exist;
  });
}
